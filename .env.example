# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Shared secret for Eve agent ↔ Nuxt internal API (memory, Slack link).
# Must match on both the Nuxt app and the Eve service in production.
INTERNAL_API_SECRET=change-me-to-a-random-string-at-least-32-chars

# Optional — canonical URL for SEO (Open Graph, canonical links)
# NUXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Database — required on Vercel (and any serverless host).
# Locally these can stay unset: NuxtHub falls back to a local SQLite file (.data/db).
# On Vercel that file cannot be created, so a hosted libSQL database is required.
# Provision via the Turso integration on the Vercel Marketplace (`vercel integration add turso`)
# and these are set automatically.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# Eve Institution — role routing and control plane
TRANSLATOR_MODEL=anthropic/claude-sonnet-4.6
TRANSLATOR_BASE_URL=
TRANSLATOR_API_KEY=
TRANSLATOR_CONTEXT_WINDOW_TOKENS=200000
SUPERVISOR_MODEL=anthropic/claude-opus-4.6
SUPERVISOR_BASE_URL=
SUPERVISOR_API_KEY=
SUPERVISOR_CONTEXT_WINDOW_TOKENS=200000
EXECUTOR_MODEL=qwen3-coder
EXECUTOR_BASE_URL=
EXECUTOR_API_KEY=
EXECUTOR_CONTEXT_WINDOW_TOKENS=131072
METABOLISM_MODEL=qwen3-8b
METABOLISM_BASE_URL=
METABOLISM_API_KEY=
METABOLISM_CONTEXT_WINDOW_TOKENS=32768
METABOLISM_SCHEDULE=*/5 * * * *
EVE_INTERNAL_ORIGIN=
PROCESS_API_TOKEN_SALT=
INSTITUTION_ADMIN_USER_IDS=
SLA_URGENT_HOURS=
INTAKE_ANALYSIS_MAX_ATTEMPTS=3
ASSIGNMENT_ACCEPT_MINUTES=10
ASSIGNMENT_LEASE_MINUTES=30
